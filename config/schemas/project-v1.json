{
  "$defs": {
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "cpus": {
          "exclusiveMinimum": 0,
          "maximum": 4,
          "title": "Cpus",
          "type": "number"
        },
        "memory_mb": {
          "maximum": 8192,
          "minimum": 64,
          "title": "Memory Mb",
          "type": "integer"
        }
      },
      "required": [
        "memory_mb",
        "cpus"
      ],
      "title": "Limits",
      "type": "object"
    },
    "Service": {

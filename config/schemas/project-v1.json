      "properties": {
        "container_port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Container Port",
          "type": "integer"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "healthcheck": {
          "items": {
            "type": "string"
          },
          "title": "Healthcheck",
          "type": "array"

        "type": "array"
      },
      "title": "Commands",
      "type": "object"
    },
    "services": {
      "additionalProperties": {
        "$ref": "#/$defs/Service"
      },
      "title": "Services",
      "type": "object"
    },
    "version": {
      "maximum": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
